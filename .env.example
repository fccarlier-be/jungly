DATABASE_URL="file:./data/plantes.db"
AUTH_SECRET="change-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Premier compte cree par le seed au demarrage, avec le role administrateur
# (seul role existant, reserve aux actions sur des donnees globales
# partagees, ex. resynchroniser une fiche de bibliotheque) -- l'inscription
# libre-service (/inscription) reste ouverte pour les comptes suivants.
SEED_USER_EMAIL="moi@example.com"
SEED_USER_PASSWORD="change-me"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notifications push (phase 5) : generer avec `npx web-push generate-vapid-keys`.
# PLANTES_VAPID_PUBLIC_KEY doit aussi etre passee en build arg Docker (voir
# Dockerfile/docker-compose.yml) car NEXT_PUBLIC_* est fige au build.
PLANTES_VAPID_PUBLIC_KEY=""
PLANTES_VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Bibliotheque dynamique -- recherche/import d'especes absentes de la
# bibliotheque locale, dans l'ordre : OpenPlantbook (soin), puis Perenual en
# repli (quota gratuit plus restreint : 3000 especes / 100 requetes par jour).
# OpenPlantbook : creer un compte + generer client_id/secret sur
# https://open.plantbook.io (OAuth2 client_credentials, pas une simple cle).
OPENPLANTBOOK_CLIENT_ID=""
OPENPLANTBOOK_CLIENT_SECRET=""
# Perenual : cle gratuite sur https://perenual.com/docs/api ("Get API Key").
PERENUAL_API_KEY=""

# Identification d'une plante par photo (POST /api/plants/identify) : cle
# gratuite sur https://my.plantnet.org/settings/api-key (500 identifications/
# jour). Sans cette variable, la fonctionnalite echoue proprement (502) au
# lieu de faire semblant de reussir.
PLANTNET_API_KEY=""

# Liste d'attente beta Android (site vitrine, /api/beta/*) : cle API sur
# https://resend.com (compte gratuit, 3000 emails/mois). Sans cette cle, les
# emails de confirmation/bienvenue sont journalises au lieu d'etre envoyes.
RESEND_API_KEY=""
# Adresse d'expedition, au format "Nom <adresse@domaine>". Le domaine doit
# etre verifie dans Resend pour envoyer en production (le domaine partage
# onboarding@resend.dev, utilise par defaut sans cette variable, est reserve
# aux tests).
BETA_SIGNUP_FROM_EMAIL=""

# Offre hebergee payante (POST /api/billing/verify-purchase, instance
# jungly-app.fcold.org uniquement) : cle JSON d'un compte de service Google
# Cloud avec acces a l'API Play Developer (Play Console > Setup > API
# access), au format JSON compact sur une seule ligne. Sans cette variable,
# la verification d'achat echoue proprement (503) au lieu de faire semblant
# de reussir.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""

# Don/echange de boutures entre comptes -- n'a de sens qu'entre comptes qui
# peuvent se rencontrer physiquement, donc reserve a jungly-app.fcold.org
# (comptes multiples sous un meme operateur), jamais a une instance
# auto-hebergee (mono-foyer par nature). Voir src/lib/features.ts.
ENABLE_CUTTINGS_MARKETPLACE="false"
# Cle AES-256-GCM (32 octets encodes en base64) pour le chiffrement au repos
# des messages prives entre utilisateurs -- genere avec `openssl rand -base64 32`.
# Distincte de AUTH_SECRET (portees differentes : session vs donnees
# chiffrees a long terme). Requise des que ENABLE_CUTTINGS_MARKETPLACE=true.
CUTTINGS_MESSAGE_ENCRYPTION_KEY=""
