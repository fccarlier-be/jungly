DATABASE_URL="file:./data/plantes.db"
AUTH_SECRET="change-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Utilisateur unique cree par le seed (pas d'inscription publique)
SEED_USER_EMAIL="moi@example.com"
SEED_USER_PASSWORD="change-me"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notifications push (phase 5) : generer avec `npx web-push generate-vapid-keys`.
# PLANTES_VAPID_PUBLIC_KEY doit aussi etre passee en build arg Docker (voir
# Dockerfile/docker-compose.yml) car NEXT_PUBLIC_* est fige au build.
PLANTES_VAPID_PUBLIC_KEY=""
PLANTES_VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Bibliotheque dynamique -- recherche/import d'especes absentes de la
# bibliotheque locale, dans l'ordre : OpenPlantbook (soin), puis Perenual en
# repli (quota gratuit plus restreint : 3000 especes / 100 requetes par jour).
# OpenPlantbook : creer un compte + generer client_id/secret sur
# https://open.plantbook.io (OAuth2 client_credentials, pas une simple cle).
OPENPLANTBOOK_CLIENT_ID=""
OPENPLANTBOOK_CLIENT_SECRET=""
# Perenual : cle gratuite sur https://perenual.com/docs/api ("Get API Key").
PERENUAL_API_KEY=""
