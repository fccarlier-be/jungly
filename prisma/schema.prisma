generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7 : "url" n'est plus supporte ici, deplace vers prisma.config.ts.
// Voir src/server/db.ts pour l'adapter (@prisma/adapter-better-sqlite3) qui
// fournit desormais la connexion au PrismaClient lui-meme.
datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Utilisateur
// ---------------------------------------------------------------------------

enum UnitSystem {
  METRIC
  IMPERIAL
}

// Retour beta (2026-09-17) : le formulaire ne prevoyait que le diametre
// (pot rond) -- une jardiniere/pot rectangulaire n'a pas de diametre.
enum PotShape {
  ROUND
  RECTANGULAR
}

// Retour beta (2026-09-17) : rien n'empechait de regrouper des plantes aux
// besoins incompatibles (ex. origan + begonia) dans la meme jardiniere.
// Optionnel : le substrat existant reste du texte libre (non comparable),
// cette etiquette sert uniquement a detecter des conflits evidents --
// silencieuse si non renseignee, jamais devinee depuis le texte libre.
enum SubstrateType {
  UNIVERSAL
  DRAINING
  MOISTURE_RETAINING
  ACIDIC
  AQUATIC
  EPIPHYTE
  MINERAL
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  // Seul l'utilisateur seed (SEED_USER_EMAIL) l'est, voir prisma/seed.ts --
  // reserve les actions affectant les donnees GLOBALES partagees entre tous
  // les comptes (ex. resynchroniser une fiche de bibliotheque commune).
  isAdmin      Boolean    @default(false)
  // Les valeurs restent stockees en unites standard (ml, mm) partout en base
  // -- seul l'affichage/la saisie (src/lib/units.ts) convertit selon ce
  // reglage, en vue notamment d'un futur public anglophone/imperial.
  unitSystem   UnitSystem @default(METRIC)
  // Non-null seulement pour un compte de l'offre hebergee dont l'achat a ete
  // rembourse/annule apres coup (voir tickPurchaseRevocationCheck) --
  // bloque la connexion (auth.ts) sans supprimer les donnees, au cas ou le
  // remboursement serait lui-meme conteste/annule. Toujours null pour un
  // compte auto-heberge (aucun achat associe).
  disabledAt   DateTime?
  // Derniere annonce (voir Announcement) que ce compte a explicitement
  // acquittee ("ne plus voir jusqu'a la prochaine annonce") -- distinct
  // d'avoir simplement FERME la modale sans cocher la case, auquel cas elle
  // reapparait au prochain chargement (voir AnnouncementModal.tsx). Null
  // pour un compte qui n'a jamais rien acquitte.
  lastSeenAnnouncementId String?
  // Horodatage du dernier passage sur /boutures (ou de la derniere fois que
  // la banniere d'accueil a ete ignoree) -- sert a compter les annonces
  // OUVERTES publiees par d'AUTRES comptes depuis cette date (voir
  // server/cuttings/notifications.ts). Null pour un compte qui n'a jamais
  // rien vu : toutes les annonces ouvertes comptent alors comme nouvelles.
  lastSeenCuttingsAt     DateTime?
  // Pseudo PUBLIC affiche aux autres membres (annonces de boutures,
  // messagerie) a la place du nom reel -- jamais expose autrement. Unique
  // sans distinction de casse ni d'accents : pseudoKey en est la forme
  // normalisee (voir server/cuttings/pseudo.ts), sans quoi "Léa" et "lea"
  // seraient indiscernables a l'ecran tout en etant deux valeurs distinctes
  // pour la contrainte d'unicite. Null tant que le compte n'en a pas choisi.
  pseudo                 String?
  pseudoKey              String?   @unique

  locations               Location[]
  containers               Container[]
  plants                   Plant[]
  fertilizers              Fertilizer[]
  notificationPreference   NotificationPreference?
  pushSubscriptions        PushSubscription[]
  weatherProfile           WeatherProfile?
  uploads                  Upload[]
  passwordResetTokens      PasswordResetToken[]
  feedbacks                Feedback[]
  lastSeenAnnouncement     Announcement?     @relation(fields: [lastSeenAnnouncementId], references: [id], onDelete: SetNull)
  cuttingListings          CuttingListing[]
  sentCuttingMessages      CuttingMessage[]  @relation("CuttingMessageSender")
  receivedCuttingMessages  CuttingMessage[]  @relation("CuttingMessageRecipient")
  cuttingRatingsGiven      CuttingRating[]   @relation("CuttingRatingRater")
  cuttingRatingsReceived   CuttingRating[]   @relation("CuttingRatingRatedUser")
  cuttingTransactionsReceived CuttingTransaction[] @relation("CuttingTransactionRecipient")
  cuttingReportsMade       CuttingReport[]   @relation("CuttingReportReporter")
  cuttingReportsReceived   CuttingReport[]   @relation("CuttingReportReported")
}

/**
 * Annonce de changement publiee par l'administrateur (voir
 * requireAdminSessionUserId), affichee en modale au chargement de l'app pour
 * tout compte dont User.lastSeenAnnouncementId differe de la derniere
 * annonce publiee (voir getLatestAnnouncement). Une seule "derniere annonce"
 * a la fois -- pas de systeme de fil/historique pour l'instant, publier une
 * nouvelle annonce rend simplement la precedente invisible pour tout le
 * monde (y compris ceux qui l'avaient deja vue, sans consequence puisqu'ils
 * ne reverront que la nouvelle).
 */
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())

  seenBy User[]
}

/**
 * Retour utilisateur (2026-09-18) : aucun moyen de recuperer un compte dont
 * le mot de passe est oublie. A usage unique (usedAt) et de courte duree
 * (voir PASSWORD_RESET_TOKEN_TTL_MS) -- une fois utilise ou expire,
 * conserve seulement pour la purge periodique (tickPasswordResetCleanup),
 * jamais reutilisable.
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Retour beta-testeur (2026-09-20) : simple texte libre envoye depuis
 * Parametres. Volontairement minimal (pas de statut ici) -- le suivi en
 * "tickets" (nouveau/en cours/resolu/fusionne) vit dans jungly-admin, pas
 * ici, puisqu'il doit agreger les retours des DEUX instances (personnelle +
 * hebergee, deux bases Prisma separees) : voir memoire
 * jungly_feedback_ticket_roadmap_plan.md pour le plan complet.
 * userId nullable : option "envoyer anonymement" (l'utilisateur reste
 * authentifie pour acceder a /feedback et televerser une capture -- voir
 * resolvePhotoUrl -- mais son identite n'est pas rattachee a CE retour).
 * onDelete SetNull (pas Cascade, contrairement au reste du schema) :
 * supprimer son compte ne doit pas effacer un retour deja envoye, utile
 * meme une fois l'auteur parti -- juste le detacher.
 */
model Feedback {
  id        String        @id @default(cuid())
  userId    String?
  topic     FeedbackTopic @default(AUTRE)
  // Retour utilisateur (2026-09-20) : sert de titre partout (admin ET page
  // publique) -- avant, jungly-admin devait deviner un titre (libelle
  // generique du theme, ou saisie manuelle par l'admin). Rempli par le
  // testeur lui-meme des la soumission, bien plus parlant.
  summary   String
  content   String
  photoUrl  String?
  createdAt DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum FeedbackTopic {
  ACCUEIL
  TACHES
  PLANTES
  PARAMETRES
  BIBLIOTHEQUE
  ENGRAIS
  AUTRE
}

// ---------------------------------------------------------------------------
// Emplacements
// ---------------------------------------------------------------------------

model Location {
  id     String  @id @default(cuid())
  userId String
  name   String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plants Plant[]

  @@unique([userId, name])
}

// ---------------------------------------------------------------------------
// Jardiniere (contenant partage par plusieurs plantes)
// ---------------------------------------------------------------------------

// Retour beta (2026-09-17) : certains utilisateurs ont plusieurs plantes
// dans une meme jardiniere/tourbiere -- avant cette table, "un pot" etait
// necessairement attache a UNE SEULE plante (champs pot* sur Plant), pas
// representable. Une plante non rattachee a un Container garde son pot
// individuel exactement comme avant (les deux modeles coexistent).
model Container {
  id            String   @id @default(cuid())
  userId        String
  name          String
  // Rectangulaire par defaut (jardiniere) plutot que ROUND comme sur Plant
  // (pot individuel) : le cas d'usage principal remonte par les retours
  // beta est la jardiniere, pas le grand pot rond partage.
  potShape      PotShape @default(RECTANGULAR)
  potDiameterMm Int?
  potLengthMm   Int?
  potWidthMm    Int?
  potHeightMm   Int?
  potMaterial   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plants Plant[]

  @@unique([userId, name])
}

// ---------------------------------------------------------------------------
// Plante
// ---------------------------------------------------------------------------

model Plant {
  id              String         @id @default(cuid())
  userId          String
  libraryEntryId  String?
  name            String
  scientificName  String?
  photoUrl        String?
  locationId      String?
  containerId     String?
  // Coordonnees normalisees (0.0-1.0) dans le contenant partage -- pas des
  // mm : independantes de l'unite d'affichage et de la taille reelle du
  // contenant, plus simples pour le schema/glisser-deposer (phase 2).
  // Sans signification tant que containerId est vide.
  positionX       Float?
  positionY       Float?
  acquiredAt      DateTime?
  potShape        PotShape       @default(ROUND)
  potDiameterMm   Int?
  potLengthMm     Int?
  potWidthMm      Int?
  potHeightMm     Int?
  potMaterial     String?
  substrate       String?
  // Etiquette optionnelle en plus du texte libre ci-dessus -- seule forme
  // comparable de substrat entre deux plantes (voir SubstrateType).
  substrateType   SubstrateType?
  exposure        String?
  temperatureNote String?
  humidityNote    String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  location        Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  container       Container?         @relation(fields: [containerId], references: [id], onDelete: SetNull)
  libraryEntry    PlantLibraryEntry? @relation(fields: [libraryEntryId], references: [id], onDelete: SetNull)
  careRules       PlantCareRule[]
  tasks           Task[]
  careEvents      CareEvent[]
  plantNotes      Note[]
  sensors         Sensor[]
  photos          PlantPhoto[]
  healthDiagnoses HealthDiagnosis[]

  @@index([userId])
}

/**
 * Galerie de photos d'une plante. `photoUrl` sur Plant reste la photo de
 * couverture (deja utilisee partout dans l'app -- cartes, dashboard, etc.),
 * cette table stocke juste les photos additionnelles parmi lesquelles
 * choisir. Une couverture peut donc exister sans etre "dans" cette table
 * (photo choisie avant l'introduction de la galerie) -- voir le backfill
 * dans la page de detail.
 */
model PlantPhoto {
  id        String   @id @default(cuid())
  plantId   String
  url       String
  createdAt DateTime @default(now())

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId])
}

// ---------------------------------------------------------------------------
// Regles d'entretien
// ---------------------------------------------------------------------------

enum CareRuleType {
  WATERING
  FERTILIZING
  REPOTTING
}

enum RecurrenceType {
  FIXED_INTERVAL_DAYS
  INTERVAL_WEEKS
  INTERVAL_MONTHS
  EXACT_DATE
  YEARLY
  MANUAL
  MOISTURE_THRESHOLD
}

model PlantCareRule {
  id             String         @id @default(cuid())
  plantId        String
  type           CareRuleType
  enabled        Boolean        @default(true)
  recurrenceType RecurrenceType
  interval       Int? // en jours / semaines / mois selon recurrenceType
  nextDueAt      DateTime?
  // Configuration libre par type de regle : quantite d'eau par defaut,
  // engrais/dosage, seuil d'humidite, saisonnalite (activeFromMonth/
  // activeUntilMonth, 1-12), etc. Voir src/server/validation pour la forme
  // attendue par type.
  configuration  Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  plant Plant  @relation(fields: [plantId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([plantId])
}

// ---------------------------------------------------------------------------
// Taches
// ---------------------------------------------------------------------------

enum TaskType {
  WATERING
  FERTILIZING
  REPOTTING
  PRUNING
  INSPECTION
  OTHER
}

enum TaskStatus {
  PENDING
  COMPLETED
  SNOOZED
  SKIPPED
}

model Task {
  id           String     @id @default(cuid())
  plantId      String
  careRuleId   String?
  type         TaskType
  title        String
  description  String?
  dueAt        DateTime
  completedAt  DateTime?
  status       TaskStatus @default(PENDING)
  snoozedUntil DateTime?
  metadata     Json?
  createdAt    DateTime   @default(now())

  plant     Plant          @relation(fields: [plantId], references: [id], onDelete: Cascade)
  careRule  PlantCareRule? @relation(fields: [careRuleId], references: [id], onDelete: SetNull)
  careEvent CareEvent?

  @@index([plantId, status])
  @@index([dueAt])
}

// ---------------------------------------------------------------------------
// Evenements de soin (historique)
// ---------------------------------------------------------------------------

enum CareEventType {
  WATERING
  FERTILIZING
  REPOTTING
  PRUNING
  INSPECTION
  OTHER
}

model CareEvent {
  id          String        @id @default(cuid())
  plantId     String
  taskId      String?       @unique
  type        CareEventType
  performedAt DateTime      @default(now())
  quantity    Float?
  unit        String?
  metadata    Json?
  note        String?
  createdAt   DateTime      @default(now())

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)
  task  Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([plantId, performedAt])
}

// ---------------------------------------------------------------------------
// Engrais
// ---------------------------------------------------------------------------

model Fertilizer {
  id            String   @id @default(cuid())
  userId        String
  name          String
  manufacturer  String?
  type          String?
  nitrogen      Float?
  phosphorus    Float?
  potassium     Float?
  defaultDosage Float?
  dosageUnit    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Notes libres
// ---------------------------------------------------------------------------

enum NoteCategory {
  OBSERVATION
  MALADIE
  PARASITE
  CROISSANCE
  FLORAISON
  AUTRE
}

model Note {
  id        String       @id @default(cuid())
  plantId   String
  content   String
  category  NoteCategory @default(OBSERVATION)
  photoUrl  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId])
}

// ---------------------------------------------------------------------------
// Diagnostic de sante par photo (QCM adaptatif + Pl@ntNet + moteur de regles
// local, voir src/server/diagnosis/). Un HealthDiagnosis fige le resultat
// au moment ou il a ete calcule (hypotheses, contexte local, resultat
// Pl@ntNet) -- consulter l'historique d'une plante ne doit jamais dependre
// d'un recalcul, dont l'issue peut changer si l'historique de soin evolue
// entre-temps.
// ---------------------------------------------------------------------------

enum SymptomCategory {
  YELLOW_LEAVES
  BROWN_LEAVES
  DROPPING_LEAVES
  WILTING
  SPOTS
  PESTS
  ABNORMAL_GROWTH
  FLOWERING_ISSUE
  OTHER
}

model HealthDiagnosis {
  id        String   @id @default(cuid())
  plantId   String
  createdAt DateTime @default(now())

  symptomCategory SymptomCategory
  // Reponses du QCM adaptatif au-dela de la categorie racine (voir
  // QcmAnswers dans src/server/diagnosis/types.ts) -- structure evolutive
  // par categorie, Json plutot que des colonnes pour ne pas migrer a chaque
  // ajustement de l'arbre de questions.
  symptomAnswers  Json
  // URLs /uploads/... des photos prises pour ce diagnostic (memes fichiers
  // que la galerie, meme pipeline de traitement -- voir uploads.ts).
  photoUrls       Json

  // Resultat brut Pl@ntNet /v2/diseases/identify, null si non appele
  // (categorie de symptome hors perimetre, ex. FLOWERING_ISSUE -- voir
  // shouldCallDiseaseId) ou si Pl@ntNet etait injoignable/en quota depasse.
  plantnetDiseaseResult Json?

  // Sorti du moteur de regles (src/server/diagnosis/ruleEngine.ts), fige au
  // moment du calcul -- voir Hypothesis[] dans types.ts.
  hypotheses           Json
  // Contexte local calcule au moment du diagnostic (ecart d'arrosage,
  // stress thermique recent, etc. -- voir LocalContext dans types.ts) :
  // conserve pour audit et amelioration future des regles, jamais recalcule
  // a l'affichage.
  localContextSnapshot Json

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([plantId, createdAt])
}

// Compteur d'usage Pl@ntNet, journalier, par instance (une ligne par jour).
// Chaque instance Jungly (personnelle, hebergee, ou une installation
// self-hosted tierce) a sa PROPRE cle API Pl@ntNet et son propre quota
// gratuit de 500/jour -- ce compteur est local a la base de CETTE instance,
// aucune coordination inter-conteneurs necessaire. Remplace le message
// d'erreur 429 qui laissait croire a un suivi reel du quota alors qu'aucun
// compteur n'existait (audit du 2026-09-22).
model PlantnetDailyUsage {
  date  String @id // "YYYY-MM-DD", fuseau serveur (TZ=Europe/Brussels, voir docker-compose.yml)
  count Int    @default(0)
}

// ---------------------------------------------------------------------------
// Bibliotheque de plantes (phase 6, non exposee en MVP)
// ---------------------------------------------------------------------------

// Joue le role de "plant_species" : bibliotheque botanique generique, separee
// des plantes reellement possedees par l'utilisateur (voir `Plant`, qui la
// reference via `libraryEntryId`). `source` distingue une fiche saisie a la
// main ("LOCAL", les ~120 profils initiaux) d'une fiche importee depuis une
// source externe ("PERENUAL", "GBIF", "POWO" en preparation pour une
// verification taxonomique future) -- `sourceId` + `@@unique` empechent de
// reimporter deux fois la meme espece externe.
model PlantLibraryEntry {
  id             String   @id @default(cuid())
  commonName     String
  scientificName String?
  family         String?
  careProfile    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  source          String    @default("LOCAL")
  sourceId        String?
  importedAt      DateTime?
  lastSyncedAt    DateTime?
  // D'ou vient specifiquement LA PHOTO -- distinct de `source` (d'ou vient
  // la FICHE) : une fiche PLANTFOLIO n'a par exemple aucune photo propre,
  // la sienne vient forcement d'un rattrapage (OPENPLANTBOOK/INATURALIST/GBIF).
  imageSource     String?
  imageSourceUrl  String?
  // Qui crediter (ex. "(c) John Doe, via GBIF") -- distinct de la licence
  // elle-meme (ex. "CC BY-NC 4.0"), auparavant confondues dans imageLicense
  // pour iNaturalist/GBIF (voir prisma/backfillImages.ts).
  imageAuthor     String?
  imageLicense    String?
  imageLicenseUrl String?

  plants Plant[]

  @@unique([source, sourceId])
}

// ---------------------------------------------------------------------------
// Preferences de notification (phase 5)
// ---------------------------------------------------------------------------

model NotificationPreference {
  id                  String    @id @default(cuid())
  userId              String    @unique
  enabled             Boolean   @default(false)
  notificationTime    String    @default("08:00")
  overdueEnabled      Boolean   @default(true)
  advanceReminderDays Int       @default(0)
  lastDigestSentAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Abonnement Web Push d'un appareil/navigateur (phase 5).
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Capteurs IoT (phase 8, non exposes en MVP)
// ---------------------------------------------------------------------------

enum SensorType {
  SOIL_MOISTURE
  TEMPERATURE
  HUMIDITY
  LIGHT
  CONDUCTIVITY
}

model Sensor {
  id         String     @id @default(cuid())
  plantId    String
  type       SensorType
  name       String
  externalId String?
  // Hash bcrypt du jeton d'ingestion (distinct de externalId, qui identifie
  // le peripherique physique) : permet a un appareil IoT de poster des
  // mesures sans session utilisateur (voir POST /api/sensors/[id]/readings).
  // Le jeton en clair n'est jamais stocke -- visible une seule fois, a la
  // creation ou a la rotation (POST /api/sensors/:id/rotate).
  apiKeyHash String     @unique
  createdAt  DateTime   @default(now())

  plant    Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  readings SensorReading[]

  @@index([plantId])
}

model SensorReading {
  id         String   @id @default(cuid())
  sensorId   String
  value      Float
  unit       String
  recordedAt DateTime @default(now())

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, recordedAt])
}

enum BetaSignupStatus {
  PENDING
  CONFIRMED
  WAITLISTED
}

/**
 * Inscription a la liste d'attente de la beta Android (site vitrine, page
 * publique sans compte Jungly). Double opt-in classique : PENDING des la
 * soumission du formulaire (email de confirmation envoye avec `token` dans
 * le lien), CONFIRMED si une des 12 places etait encore libre au moment du
 * clic, WAITLISTED sinon (les places s'etant remplies entre la soumission
 * et la confirmation). Le compteur public (GET /api/beta/count) ne compte
 * que les CONFIRMED.
 */
model BetaSignup {
  id          String           @id @default(cuid())
  email       String           @unique
  token       String           @unique
  status      BetaSignupStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  confirmedAt DateTime?
  // Rempli quand une invitation (lien de test ferme Play Console) a ete
  // envoyee -- distinct de confirmedAt : sert au panel d'administration
  // separe (jungly-admin) pour reperer qui a deja ete invite, sans empecher
  // un renvoi volontaire (pas de contrainte bloquante cote serveur).
  invitedAt   DateTime?
}

/**
 * Vue de page cote site vitrine (jungly.fcold.org), pour comparer le trafic
 * aux inscriptions BetaSignup confirmees (page /analytics, reservee a
 * l'administrateur) -- repondre a "les gens visitent sans s'inscrire" vs
 * "pas assez de visibilite" ne demande qu'un compte par page et par jour,
 * jamais un identifiant de visiteur : aucune IP, cookie ou user-agent n'est
 * stocke ici, coherent avec la promesse de confidentialite du produit
 * lui-meme.
 */
model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
}

/**
 * Trace chaque jeton d'achat Google Play une fois verifie aupres de l'API
 * Play Developer, sur CETTE instance uniquement (l'offre hebergee,
 * jungly-app.fcold.org) : la contrainte d'unicite sur `purchaseToken`
 * empeche qu'un meme achat serve a provisionner plusieurs comptes en le
 * rejouant (POST /api/billing/verify-purchase). `email` est l'email du
 * compte cree a partir de cet achat -- pas de relation formelle vers User
 * pour rester independant du cycle de vie du compte (suppression de compte
 * possible sans perdre la trace qu'un achat a bien ete consomme).
 */
model ConsumedPurchase {
  id            String    @id @default(cuid())
  purchaseToken String    @unique
  productId     String
  email         String
  verifiedAt    DateTime  @default(now())
  // Renseigne par la verification periodique (tickPurchaseRevocationCheck)
  // si l'achat n'est plus dans l'etat "achete" aupres de Google
  // (rembourse/annule) -- le compte User correspondant est alors desactive
  // (voir User.disabledAt), jamais supprime automatiquement.
  revokedAt     DateTime?
}

/**
 * Trace qui a physiquement televerse un fichier via POST /api/uploads,
 * avant meme qu'il soit attache a une plante/note -- necessaire pour
 * verifier l'ownership d'une URL /uploads/... fournie par le client sur les
 * routes qui l'acceptent (creation/edition de plante, photo, note), voir
 * assertOwnedUpload() dans src/server/uploads.ts. `filename` est deja
 * l'identifiant unique utilise dans l'URL (`/uploads/<filename>`).
 */
model Upload {
  filename  String   @id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Empreinte des donnees sources du seed (bibliotheque locale + plantfolio).
 * Permet a `prisma/seed.ts` de sauter le reparcours complet (des centaines
 * de requetes SQLite sequentielles) quand rien n'a change depuis le dernier
 * deploiement -- sans elle, chaque redemarrage de conteneur repayait ce cout
 * meme pour un changement de code sans rapport avec la bibliotheque.
 */
model SeedFingerprint {
  key       String   @id
  hash      String
  updatedAt DateTime @updatedAt
}

/**
 * Ajustement automatique de l'intervalle d'arrosage selon la meteo de la
 * ville de l'utilisateur (Open-Meteo, pas de cle API). Un ajustement par
 * utilisateur, pas global : chacun sa ville. `wateringIntervalMultiplier`
 * est applique a l'intervalle des regles d'arrosage (< 1 = plus frequent,
 * > 1 = moins frequent) ; sa presence (une ligne existe) signifie que la
 * fonctionnalite est active pour cet utilisateur.
 */
model WeatherProfile {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  city                       String
  latitude                   Float
  longitude                  Float
  wateringIntervalMultiplier Float    @default(1)
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Don / echange de boutures entre comptes (instance hebergee uniquement,
// voir src/lib/features.ts) -- ajoute le 2026-09-23.
// ---------------------------------------------------------------------------

enum CuttingListingType {
  DON
  ECHANGE
}

enum CuttingListingStatus {
  OUVERTE
  RESERVEE
  TERMINEE
  ANNULEE
}

enum CuttingReportReason {
  VENTE
  COMPORTEMENT
  AUTRE
}

enum CuttingReportStatus {
  OUVERT
  TRAITE
}

/**
 * Annonce de bouture a donner ou echanger. Au moins une photo est exigee a
 * la creation (validation cote route, voir validation/cutting.ts) --
 * exigence produit explicite, jamais une simple recommandation.
 * `quantity` : nombre de boutures proposees AU TOTAL -- une annonce donne
 * lieu a autant de CuttingTransaction que de destinataires (ex. 5 boutures :
 * 3 a X, 1 a Y, 1 a Z = 3 transactions). Le stock restant se deduit
 * (quantity - somme des transactions), l'annonce passe TERMINEE quand il
 * tombe a 0. Jamais de vente : les boutures se donnent ou s'echangent.
 */
model CuttingListing {
  id          String               @id @default(cuid())
  userId      String
  title       String
  species     String?
  description String?
  type        CuttingListingType
  status      CuttingListingStatus @default(OUVERTE)
  photoUrls   Json
  quantity    Int                  @default(1)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     CuttingMessage[]
  transactions CuttingTransaction[]
  reports      CuttingReport[]

  @@index([status, createdAt])
  @@index([userId])
}

/**
 * Message prive entre deux comptes a propos d'UNE annonce. Le corps est
 * chiffre au repos (AES-256-GCM, voir server/cuttings/crypto.ts) -- jamais
 * stocke en clair, mais dechiffrable par le serveur (cle detenue par
 * l'operateur, pas par les utilisateurs) : protege contre une fuite de la
 * base ou une sauvegarde volee, pas un chiffrement de bout en bout (choix
 * assume, voir la discussion produit du 2026-09-23).
 */
model CuttingMessage {
  id             String   @id @default(cuid())
  listingId      String
  senderId       String
  recipientId    String
  bodyCiphertext String
  bodyIv         String
  bodyAuthTag    String
  createdAt      DateTime @default(now())
  readAt         DateTime?

  listing   CuttingListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sender    User           @relation("CuttingMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User           @relation("CuttingMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([recipientId, readAt])
}

/**
 * Un echange effectivement realise : `quantity` boutures remises par le
 * proprietaire de l'annonce a `recipientId`. Enregistre par le proprietaire
 * apres confirmation explicite ("la transaction avec X a-t-elle bien eu
 * lieu ?") -- c'est ce qui ouvre la possibilite de se noter mutuellement.
 */
model CuttingTransaction {
  id          String   @id @default(cuid())
  listingId   String
  recipientId String
  quantity    Int
  createdAt   DateTime @default(now())

  listing   CuttingListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  recipient User            @relation("CuttingTransactionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  ratings   CuttingRating[]

  @@index([listingId])
  @@index([recipientId])
}

/**
 * Note laissee par un participant a l'autre APRES une transaction (etat des
 * boutures, correspondance avec les photos, conseils...). Une seule note par
 * (transaction, auteur) -- chacun des deux participants note l'autre une
 * fois PAR transaction, jamais plus.
 */
model CuttingRating {
  id            String   @id @default(cuid())
  transactionId String
  raterId       String
  ratedUserId   String
  score         Int
  comment       String?
  createdAt     DateTime @default(now())

  transaction CuttingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  rater       User               @relation("CuttingRatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  ratedUser   User               @relation("CuttingRatingRatedUser", fields: [ratedUserId], references: [id], onDelete: Cascade)

  @@unique([transactionId, raterId])
  @@index([ratedUserId])
}

/**
 * Signalement d'un membre (typiquement : tentative de VENDRE des boutures
 * contre de l'argent, interdit -- l'outil ne doit jamais etre detourne en
 * marketplace). `evidence*` : capture chiffree (meme cle que les messages)
 * des derniers messages echanges entre les deux comptes sur cette annonce,
 * prise AU MOMENT du signalement avec l'accord implicite de l'auteur --
 * sans elle, l'administrateur ne pourrait pas verifier les faits (les
 * messages sont chiffres au repos, jamais lisibles depuis l'admin).
 */
model CuttingReport {
  id               String              @id @default(cuid())
  reporterId       String
  reportedUserId   String
  listingId        String?
  reason           CuttingReportReason
  comment          String?
  evidenceCiphertext String?
  evidenceIv         String?
  evidenceAuthTag    String?
  status           CuttingReportStatus @default(OUVERT)
  createdAt        DateTime            @default(now())
  handledAt        DateTime?

  reporter     User            @relation("CuttingReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User            @relation("CuttingReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  listing      CuttingListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}
